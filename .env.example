SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

NEXT_PUBLIC_SITE_URL=https://www.exemple.be

# Brevo (newsletter). La clé se crée dans Brevo, SMTP et API, onglet Clés d'API.
BREVO_API_KEY=xkeysib-votre-cle-api
# Identifiant de la liste qui reçoit les inscrits (Contacts > Listes, colonne Id).
BREVO_LIST_ID=3
# Modèle d'email de confirmation double opt-in (Campagnes > Modèles).
BREVO_DOI_TEMPLATE_ID=1

# Formulaire de contact : où arrivent les messages du site.
CONTACT_TO_EMAIL=destinataire@exemple.be
# Expéditeur des emails envoyés par le site. Doit être vérifié dans Brevo
# (Expéditeurs, domaine, IP), sans quoi Brevo refuse l'envoi.
BREVO_SENDER_EMAIL=lb.antonino7@gmail.com
BREVO_SENDER_NAME="BEHYBRID Website"
